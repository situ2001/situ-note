---
import { type CollectionEntry } from "astro:content";

import { blog } from "@/features/blog/blog";

import BaseLayout from "@/features/site/BaseLayout.astro";
import { BlogListItem } from "@/features/blog/BlogListItem";

export const getStaticPaths = blog.categoryPaths;

type Props = {
  posts: CollectionEntry<"blog">[];
  category: string;
};

const { posts, category } = Astro.props;

// TODO use the styles of blog list page
---

<BaseLayout
  title={`Category ${category}`}
  description={`Page of category ${category}`}
  fullWidth
>
  <section>
    <h1 class="text-xl">Category: {category}</h1>
    <hr class="my-1" />
    <ul>
      {posts.map((post) => <BlogListItem post={post} />)}
    </ul>
  </section>
</BaseLayout>
