---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
    getPostSortedByDate,
    posts as postsData,
    groupPostsByYear,
} from "../../api/blog";
import { BlogListItem } from "@/components/BlogListItem";

const posts = getPostSortedByDate(postsData);
const postsByYear = groupPostsByYear(posts);
const years = Object.keys(postsByYear)
    .map(Number)
    .sort((a, b) => b - a);
---

<BaseLayout title="Blogs" description="Blog" fullWidth>
    <h1 class="heading-with-underline text-3xl font-medium mb-6">Blog</h1>
    <div class="space-y-12">
        {
            years.map((year) => (
                <section class="flex gap-4 md:gap-8">
                    <div class="w-16 md:w-24 shrink-0 relative">
                        <span class="sticky top-20 block text-3xl md:text-4xl tabular-nums select-none text-zinc-300 dark:text-zinc-700">
                            {year}
                        </span>
                    </div>
                    <ul class="flex-1 min-w-0 border-l border-zinc-200 dark:border-zinc-800 pl-4 md:pl-8">
                        {postsByYear[year].map((post) => (
                            <BlogListItem post={post} />
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</BaseLayout>
