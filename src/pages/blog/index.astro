---
import BaseLayout from "@/features/site/BaseLayout.astro";
import { blog } from "@/features/blog/blog";
import BlogArchive from "@/features/blog/BlogArchive";

const years = blog.archiveByYear().map(({ year, posts }) => ({
  year,
  posts: posts.map((post) => ({
    id: post.id,
    title: post.data.title,
    date: post.data.date.toISOString(),
  })),
}));
---

<BaseLayout title="Blogs" description="Blog" fullWidth>
  <h1 class="heading-with-underline text-3xl font-medium mb-6">Blog</h1>
  <BlogArchive years={years} />
</BaseLayout>
