---
import { render, type CollectionEntry } from "astro:content";

import BlogPost from "@/features/reading/BlogPost.astro";
import { blog } from "@/features/blog/blog";
import { postCoverImage } from "@/features/blog/coverImage";

export const getStaticPaths = blog.postPaths;

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);
const cover = await postCoverImage(post);
const oembed = new URL(`/oembed/${post.id}.json`, Astro.site).href;
---

<BlogPost {...post.data} headings={headings} cover={cover} oembed={oembed}>
  <Content />
</BlogPost>
