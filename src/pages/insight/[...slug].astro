---
import { render, type CollectionEntry } from "astro:content";
import "@/features/reading/blog-post.css";
import "katex/dist/katex.min.css";
import BaseLayout from "@/features/site/BaseLayout.astro";
import { insights } from "@/features/insight/insight";

export const getStaticPaths = () => {
  return insights.map((post) => ({
    params: { slug: post.id },
    props: { ...post },
  }));
};
type Props = CollectionEntry<"insight">;

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={""} searchable>
  <div class="max-w-measure mx-auto">
    <article class="reading min-w-0" data-pagefind-body>
      <Content />
    </article>
  </div>
</BaseLayout>
