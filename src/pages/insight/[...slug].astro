---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/features/site/BaseLayout.astro";
import { insights } from "@/features/insight/insight";

export const getStaticPaths = () => {
  return insights.map((post) => ({
    params: { slug: post.slug },
    props: { ...post },
  }));
};
type Props = CollectionEntry<"insight">;

const post = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={""} searchable>
  <div data-pagefind-body>
    <Content />
  </div>
</BaseLayout>
