---
import BaseHtmlHead from "./BaseHtmlHead.astro";
import NavigationBar from "./NavigationBar";

import config from "config";
import type { Props as HeadProps } from "./BaseHtmlHead.astro";
const { author } = config;

interface Props {
  title: string;
  description: string;
  image?: HeadProps["image"];
  article?: HeadProps["article"];
  oembed?: string;
  fullWidth?: boolean;
  /** Pages with searchable=true are indexed by Pagefind. Defaults to false. */
  searchable?: boolean;
  /** Pages with paper=true get the print-like paper treatment (see global.css). Defaults to true. */
  paper?: boolean;
}
const { title, description, image, article, oembed, searchable = false, paper = true } = Astro.props;

const year = new Date().getFullYear();
---

<html lang="zh">
  <head itemscope itemtype={`https://schema.org/${article ? "Article" : "WebPage"}`}>
    <BaseHtmlHead title={title} description={description} image={image} article={article} oembed={oembed} />
  </head>
  <body
    class:list={[
      "bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-300 h-full",
      { paper },
    ]}
    {...(!searchable ? { 'data-pagefind-ignore': '' } : {})}
  >
    <header class="top-0 sticky z-50">
      <NavigationBar client:load />
    </header>
    <main class="px-4 min-[400px]:px-6 py-6 mx-auto max-w-screen-md">
      <slot />
    </main>
  </body><footer
    class="p-6 mx-auto max-w-screen-md text-center text-sm text-zinc-500 flex flex-col-reverse gap-2 md:gap-0 md:flex-row justify-between"
  >
    <p>
      © {year}
      {author}. All rights reserved.
    </p>
    <p>
      <a href="/changelog" class="underline">Changelog</a>
    </p>
  </footer>
</html>
