---
import pluralize from "pluralize";

import type { CollectionEntry } from "astro:content";

import FormattedDate from "@/features/blog/FormattedDate";

import BaseLayout from "@/features/site/BaseLayout.astro";

// KaTeX CSS
import "katex/dist/katex.min.css";
// CSS for the blog post
import "@/features/reading/blog-post.css";

import { blog } from "@/features/blog/blog";
import type { MarkdownHeading } from "astro";
import MediumZoom from "@/features/reading/MediumZoom";
import type { CoverImage } from "@/features/blog/coverImage";

type Props = CollectionEntry<"blog">["data"] & { headings: MarkdownHeading[]; sharingImage: CoverImage; oembed: string };
const { title, description, date, updatedDate, categories, headings, heroImage, sharingImage, oembed } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={sharingImage}
  oembed={oembed}
  article={{ publishedTime: date, modifiedTime: updatedDate, tags: blog.categoriesFor(categories) }}
  searchable
  paper
>
  <MediumZoom selectors={["article.reading img:not(a img)"]} client:only />
  <div class="max-w-measure mx-auto">
    <div class="font-serif mb-4">
      <h1 class="text-3xl mb-1">{title}</h1>
      {!heroImage && <p class="text-sm text-muted mb-3">{description}</p>}
      <div class="text-sm text-muted">
        <FormattedDate date={date.toISOString()} />
      </div>
      <div class="text-sm text-muted">
        {
          pluralize(
            "Category",
            blog.categoriesFor(categories).length,
            false,
          )
        }
        {": "}
        {
          blog.categoriesFor(categories).map((category, index) => (
            <>
              {index > 0 && "/"}
              <a href={`/blog/category/${category}`}>
                <span class="hover:underline underline-offset-4">
                  {category}
                </span>
              </a>
            </>
          ))
        }
      </div>
    </div>
    <hr />
    <article class="reading min-w-0" data-pagefind-body>
      {
        heroImage && (
          <figure class="article-hero">
            <img src={sharingImage.src} alt={sharingImage.alt} width={sharingImage.width} height={sharingImage.height} />
            {description && <figcaption>{description}</figcaption>}
          </figure>
        )
      }
      <!-- Main Content -->
      <slot />
    </article>
  </div>
</BaseLayout>
