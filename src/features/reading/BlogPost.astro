---
import pluralize from "pluralize";

import type { CollectionEntry } from "astro:content";

import FormattedDate from "@/features/blog/FormattedDate";

import BaseLayout from "@/layouts/BaseLayout.astro";

// KaTeX CSS
import "katex/dist/katex.min.css";
// CSS for the blog post
import "@/features/reading/blog-post.css";

import { blog } from "@/features/blog/blog";
import type { MarkdownHeading } from "astro";
import MediumZoom from "@/features/reading/MediumZoom";

type Props = CollectionEntry<"blog">["data"] & { headings: MarkdownHeading[] };
const { title, description, date, categories, headings } = Astro.props;
---

<BaseLayout title={title} description={description} searchable paper>
  <MediumZoom selectors={["article.reading img:not(a img)"]} client:only />
  <div class="max-w-measure mx-auto">
    <div class="font-serif mb-4">
      <h1 class="text-3xl mb-1">{title}</h1>
      <FormattedDate date={date} />
      <div>
        {
          pluralize(
            "Category",
            blog.categoriesFor(categories).length,
            false,
          )
        }
        {": "}
        {
          blog.categoriesFor(categories).map((category, index) => (
            <>
              {index > 0 && "/"}
              <a href={`/blog/category/${category}`}>
                <span class="hover:underline underline-offset-4">
                  {category}
                </span>
              </a>
            </>
          ))
        }
      </div>
    </div>
    <hr />
    <article class="reading min-w-0" data-pagefind-body>
      <!-- Description -->
      {
        description ? (
          <p class="text-zinc-600 border-l-4 border-zinc-300 px-4 py-2 my-6 bg-surface dark:text-zinc-300 dark:border-zinc-700">
            {description}
          </p>
        ) : null
      }
      <!-- Main Content -->
      <slot />
    </article>
  </div>
</BaseLayout>
