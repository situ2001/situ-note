# Apply in the Instant View editor for situ2001.com.
~version: "2.1"

?exists: //meta[@property="og:type" and @content="article"]
body: //article[has-class("reading")]
title: //main//h1
description: //meta[@property="og:description"]/@content
image_url: //meta[@property="og:image"]/@content
site_name: //meta[@property="og:site_name"]/@content
author: //meta[@name="author"]/@content
author_url: //meta[@property="article:author"]/@content
@datetime(0): //meta[@property="article:published_time"]/@content
published_date: $@
cover: $body/figure[has-class("article-hero")]

# Browser images use WebP; separate full-size assets use IV-compatible formats.
@set_attr(src, @data-instant-view-src): $body//img[@data-instant-view-src]
@remove: $body//img/@srcset
@wrap(<figure>): $body//p/img
@split_parent: $body//p/figure

# Shiki already puts data-language on pre; preserve its whitespace in IV.
@pre: $body//pre

# TODO: Preserve rendered math in IV, then remove the LaTeX conversion and notice.
$math: $body//span[has-class("katex")]
@if($math) {
  # TODO: Put this notice in source HTML before requesting Telegram review (Checklist 5).
  @prepend(<p>): $body
  @append(<a>, href, "./ancestor::html/head/link[@rel='canonical']/@href"): $@
  @append("Formulas are shown as LaTeX. Open the original article to view rendered equations."): $@
}
@before_el("./ancestor::span[@class='katex']"): $math//*[name()="annotation"]
<code>: $@
@remove: $math

# These article features require JavaScript.
@unsupported: $body//*[self::astro-island or self::canvas]
